# Required. Gemini for origin, search, and recipe parse.
GEMINI_API_KEY=

# Shared ingredient catalog (Turso / libSQL). Required for npm run dev and
# production. Use the same values locally and on Vercel.
#   turso auth login
#   turso db show taster --url
#   turso db tokens create taster
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
